#include <stdio.h>

#define V 4
#define INF 999999

int main() {
    // Adjacency matrix representation of an undirected weighted graph
    int graph[V][V] = {
        { 0,  4,  0,  5},
        { 4,  0,  9,  8},
        { 0,  9,  0,  0},
        { 5,  8,  0,  0}
    };

    int visited[V] = {0}; // Track visited vertices
    int edges = 0;        // Count of edges included in MST
    int min, u = 0, v = 0, totalWeight = 0;

    // Start MST construction from vertex 0
    visited[0] = 1;

    printf("Edge   | Weight\n");
    printf("---------------\n");

    // An MST with V vertices always has V - 1 edges
    while (edges < V - 1) {
        min = INF;

        for (int i = 0; i < V; i++) {
            if (visited[i] == 1) {
                for (int j = 0; j < V; j++) {
                    // Look for an unvisited vertex reachable from an already visited vertex
                    if (visited[j] == 0 && graph[i][j] != 0) {
                        if (graph[i][j] < min) {
                            min = graph[i][j];
                            u = i;
                            v = j;
                        }
                    }
                }
            }
        }

        printf("%d - %d  | %d\n", u, v, min);
        visited[v] = 1;
        totalWeight += min;
        edges++;
    }

    printf("\nTotal MST Weight = %d\n", totalWeight);

    return 0;
}
