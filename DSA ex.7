#include <stdio.h>
#include <ctype.h>

int stack[100];
int top = -1;

// Push value onto stack
void push(int value) {
    stack[++top] = value;
}

// Pop value from stack
int pop() {
    return stack[top--];
}

int main() {
    char exp[100];
    int i, V1, V2, result;

    printf("Enter postfix expression (e.g., 231*+9-): ");
    scanf("%99s", exp); // Limit input to prevent overflow

    for (i = 0; exp[i] != '\0'; i++) {
        // If operand (digit), convert character to integer digit and push
        if (isdigit((unsigned char)exp[i])) {
            push(exp[i] - '0');
        } 
        // If operator, pop two operands and calculate
        else {
            if (top < 1) {
                printf("Error: Invalid postfix expression!\n");
                return 1;
            }

            V2 = pop();
            V1 = pop();

            switch (exp[i]) {
                case '+':
                    result = V1 + V2;
                    break;
                case '-':
                    result = V1 - V2;
                    break;
                case '*':
                    result = V1 * V2;
                    break;
                case '/':
                    if (V2 == 0) {
                        printf("Error: Division by zero!\n");
                        return 1;
                    }
                    result = V1 / V2;
                    break;
                default:
                    printf("Invalid operator '%c' encountered!\n", exp[i]);
                    return 1;
            }
            push(result);
        }
    }

    if (top == 0) {
        printf("Result = %d\n", pop());
    } else {
        printf("Error: Invalid postfix expression!\n");
    }

    return 0;
}
