#include <stdio.h>
#include <stdlib.h>

// Utility function to swap two integers
void swap(int *a, int *b) {
    int temp = *a;
    *a = *b;
    *b = temp;
}

// 1. Selection Sort
void selectionSort(int arr[], int n) {
    for (int i = 0; i < n - 1; i++) {
        int smallestIndx = i;
        for (int j = i + 1; j < n; j++) {
            if (arr[j] < arr[smallestIndx]) {
                smallestIndx = j;
            }
        }
        swap(&arr[i], &arr[smallestIndx]);
    }
}

// 2. Bubble Sort
void bubbleSort(int arr[], int n) {
    for (int i = 0; i < n - 1; i++) {
        for (int j = 0; j < n - i - 1; j++) {
            if (arr[j] > arr[j + 1]) {
                swap(&arr[j], &arr[j + 1]);
            }
        }
    }
}

// 3. Insertion Sort
void insertionSort(int arr[], int n) {
    for (int i = 1; i < n; i++) {
        int curr = arr[i];
        int prev = i - 1;
        while (prev >= 0 && arr[prev] > curr) {
            arr[prev + 1] = arr[prev];
            prev--;
        }
        arr[prev + 1] = curr;
    }
}

// Merge step for Merge Sort
void merge(int arr[], int l, int m, int h) {
    int size = h - l + 1;
    int temp[size];
    int i = l;
    int j = m + 1;
    int k = 0;

    while (i <= m && j <= h) {
        if (arr[i] <= arr[j]) {
            temp[k++] = arr[i++];
        } else {
            temp[k++] = arr[j++];
        }
    }

    while (i <= m) {
        temp[k++] = arr[i++];
    }

    while (j <= h) {
        temp[k++] = arr[j++];
    }

    for (i = l, k = 0; i <= h; i++, k++) {
        arr[i] = temp[k];
    }
}

// 4. Merge Sort
void mergeSort(int arr[], int l, int h) {
    if (l < h) {
        int m = l + (h - l) / 2;
        mergeSort(arr, l, m);
        mergeSort(arr, m + 1, h);
        merge(arr, l, m, h);
    }
}

// Partition step for Quick Sort
int partition(int arr[], int low, int high) {
    int pivot = arr[high];
    int i = low - 1;

    for (int j = low; j < high; j++) {
        if (arr[j] < pivot) {
            i++;
            swap(&arr[i], &arr[j]);
        }
    }
    swap(&arr[i + 1], &arr[high]);
    return i + 1;
}

// 5. Quick Sort
void quickSort(int arr[], int low, int high) {
    if (low < high) {
        int pi = partition(arr, low, high);
        quickSort(arr, low, pi - 1);
        quickSort(arr, pi + 1, high);
    }
}

// Print array elements
void printArr(int arr[], int n) {
    for (int i = 0; i < n; i++) {
        printf("%d ", arr[i]);
    }
    printf("\n");
}

int main() {
    int arr[] = {4, 9, 234, 56, 10};
    int n = sizeof(arr) / sizeof(arr[0]);
    int ch;

    printf("Original array: ");
    printArr(arr, n);

    printf("\nSelect Sorting Algorithm:\n");
    printf("1. Selection Sort\n");
    printf("2. Insertion Sort\n");
    printf("3. Bubble Sort\n");
    printf("4. Merge Sort\n");
    printf("5. Quick Sort\n");
    printf("Enter choice (1-5): ");

    if (scanf("%d", &ch) != 1) {
        printf("Invalid input\n");
        return 1;
    }

    switch (ch) {
        case 1:
            selectionSort(arr, n);
            printf("Sorted via Selection Sort: ");
            printArr(arr, n);
            break;
        case 2:
            insertionSort(arr, n);
            printf("Sorted via Insertion Sort: ");
            printArr(arr, n);
            break;
        case 3:
            bubbleSort(arr, n);
            printf("Sorted via Bubble Sort: ");
            printArr(arr, n);
            break;
        case 4:
            mergeSort(arr, 0, n - 1);
            printf("Sorted via Merge Sort: ");
            printArr(arr, n);
            break;
        case 5:
            quickSort(arr, 0, n - 1);
            printf("Sorted via Quick Sort: ");
            printArr(arr, n);
            break;
        default:
            printf("Invalid choice\n");
    }

    return 0;
}
