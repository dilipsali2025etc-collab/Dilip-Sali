#include <stdio.h>
#include <stdlib.h>

// Definition of Linked List Node
typedef struct node {
    int data;
    struct node* next;
} Node;

// Global pointers for Stack and Queue
Node* top = NULL;
Node* front = NULL;
Node* rear = NULL;

// --- STACK OPERATIONS (LIFO) ---

void push(int value) {
    Node* newNode = (Node*)malloc(sizeof(Node));
    if (newNode == NULL) {
        printf("Memory allocation failed. Stack full.\n");
        return;
    }
    newNode->data = value;
    newNode->next = top;
    top = newNode;
    printf("%d pushed to stack.\n", value);
}

void pop() {
    if (top == NULL) {
        printf("Stack Underflow! Stack is empty.\n");
        return;
    }
    Node* temp = top;
    printf("The popped element is %d.\n", temp->data);
    top = top->next;
    free(temp);
}

void displayStack() {
    if (top == NULL) {
        printf("Stack is empty.\n");
        return;
    }
    Node* temp = top;
    printf("Stack (Top to Bottom): ");
    while (temp != NULL) {
        printf("%d ", temp->data);
        temp = temp->next;
    }
    printf("\n");
}

// --- QUEUE OPERATIONS (FIFO) ---

void enqueue(int value) {
    Node* newNode = (Node*)malloc(sizeof(Node));
    if (newNode == NULL) {
        printf("Memory allocation failed. Queue full.\n");
        return;
    }
    newNode->data = value;
    newNode->next = NULL;

    if (rear == NULL) {
        front = rear = newNode;
    } else {
        rear->next = newNode;
        rear = newNode;
    }
    printf("%d enqueued to queue.\n", value);
}

void dequeue() {
    if (front == NULL) {
        printf("Queue Underflow! Queue is empty.\n");
        return;
    }
    Node* temp = front;
    printf("%d dequeued from queue.\n", temp->data);
    front = front->next;

    // Reset rear when queue becomes completely empty
    if (front == NULL) {
        rear = NULL;
    }
    free(temp);
}

void displayQueue() {
    if (front == NULL) {
        printf("Queue is empty.\n");
        return;
    }
    Node* temp = front;
    printf("Queue (Front to Rear): ");
    while (temp != NULL) {
        printf("%d ", temp->data);
        temp = temp->next;
    }
    printf("\n");
}

// --- MAIN FUNCTION ---

int main() {
    int choice, value;

    do {
        printf("\n=== Linked List Data Structures ===");
        printf("\n1. Push (Stack)");
        printf("\n2. Pop (Stack)");
        printf("\n3. Display Stack");
        printf("\n4. Enqueue (Queue)");
        printf("\n5. Dequeue (Queue)");
        printf("\n6. Display Queue");
        printf("\n7. Exit");
        printf("\nEnter your choice: ");

        if (scanf("%d", &choice) != 1) {
            printf("Invalid input. Please enter a number.\n");
            while (getchar() != '\n'); // Clear buffer on invalid character
            continue;
        }

        switch (choice) {
            case 1:
                printf("Enter value to push: ");
                scanf("%d", &value);
                push(value);
                break;
            case 2:
                pop();
                break;
            case 3:
                displayStack();
                break;
            case 4:
                printf("Enter value to enqueue: ");
                scanf("%d", &value);
                enqueue(value);
                break;
            case 5:
                dequeue();
                break;
            case 6:
                displayQueue();
                break;
            case 7:
                printf("Exiting application...\n");
                break;
            default:
                printf("Invalid choice! Please select 1-7.\n");
        }
    } while (choice != 7);

    return 0;
}
